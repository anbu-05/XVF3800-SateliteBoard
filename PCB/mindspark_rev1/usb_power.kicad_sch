	(text "USB-C ESP32 (J102)"
		(exclude_from_sim no)
		(at 149.6261 15.81 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "4d5d3a87-6cf0-5f9d-8fca-3f085eaf8cd1")
	)
	(text "USB: no PD, Rd 5.1k on CC1/CC2, so a source offers 5 V only. SBU unused. Shield tied to GND.\nTPS2121 (SLVSEA3F): XCOMP priority, switches to the ESP32 port when main VBUS < 4.4 V. ILIM 3.2 A typ for a 2.4 A peak load. OV1/OV2 trip at 5.57 V to\nprotect the 5.5 V-max bucks, amp and LEDs.\nST = high when the main port (IN1) powers the board, low on the ESP32 port; read by ESP32 GPIO18."
		(exclude_from_sim no)
		(at 14.54 188.4908 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "c21f090e-9262-5043-ac1a-3b30e0014557")
	)
	(text "Power mux (U103), main port first"
		(exclude_from_sim no)
		(at 15.81 91.4582 0)
		(effects
