	)
	(text "JTAG (J301, 1.8 V) + pads"
		(exclude_from_sim no)
		(at 15.81 129.0145 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "62d83140-9a18-51e6-8bce-8c3f5ebf9287")
	)
	(text "24 MHz crystal"
		(exclude_from_sim no)
		(at 117.5458 94.5108 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "bc15cb2b-de2c-5cbb-8830-a3707d5feb1b")
	)
	(text "Pins 39, 44, 45, 53, 55 go to the 2x12 header (sheet esp32_io); 55 (INT_N) also to ESP32 GPIO17, 56/58 (LED_R/G) to the status LED and ESP32\nGPIO15/16. Pin 54 (SQ_nLIN, geometry select on XMOS's board) and the SPI-control and XLINK pins end on pads (sheet xvf3800_periph). Pin 25 is NC. MCLK\nloop: pin 14 to pin 41 as a short PCB trace.\nDecoupling per XU316: >= 8 x 100 nF on VDD, 100 nF per VDDIO pin, >= 10 uF per rail; PLL_AVDD via 600 R ferrite + 1 uF. Crystal on the 1.8 V bank.\nUSB D+/D- go straight to the main USB-C (ESD on sheet usb_power); bus-powered, no VBUS sense."
		(exclude_from_sim no)
		(at 14.54 174.1645 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "db6d718d-34b3-5cb2-9801-b5982c3571a5")
	)
	(text "Reset supervisor (U302)"
		(exclude_from_sim no)
		(at 177.4991 94.5108 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "e87066b0-8d43-51ee-9aee-332fa180ded4")
	)
